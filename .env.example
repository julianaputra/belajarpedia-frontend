# =============================================================================
# Belajarpedia Frontend — Environment Variables
# =============================================================================
# Copy to .env.local for development. Never commit .env.local.

# -----------------------------------------------------------------------------
# Public site URL (canonical, sitemap, JSON-LD)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Laravel API base URL (Sanctum SPA cookie auth)
#   Local:    http://localhost:8000
#   Staging:  https://api.staging.belajarpedia.com
#   Prod:     https://api.belajarpedia.com
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Internal revalidation webhook secret
# Must match Laravel's REVALIDATE_SECRET. Server-only — never NEXT_PUBLIC_.
# -----------------------------------------------------------------------------
REVALIDATE_SECRET=change-me-to-a-long-random-string

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (bot protection on register/login/inquiry/review/forms)
# Site key is public (rendered in HTML). Secret key lives in Laravel.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# -----------------------------------------------------------------------------
# Google Maps JS API (detail page map)
# Restrict by HTTP referrer in Google Cloud Console: *.belajarpedia.com/*
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GMAPS_KEY=

# -----------------------------------------------------------------------------
# Sentry DSN (frontend error tracking)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# -----------------------------------------------------------------------------
# Cloudflare R2 (image hosting via custom Next/Image loader)
# Public read URL prefix; e.g. https://images.belajarpedia.com or
# https://pub-xxxxx.r2.dev
# -----------------------------------------------------------------------------
NEXT_PUBLIC_R2_PUBLIC_URL=https://images.belajarpedia.com

# -----------------------------------------------------------------------------
# Mock API mode (development only)
# When true, all API calls bypass the network and return canned data from
# src/lib/api/mock/. Set to false (or omit) once the Laravel backend is ready.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_USE_MOCK_API=true

# -----------------------------------------------------------------------------
# HTTP Basic Auth gate (staging / preview deploys only)
# When BOTH variables are set, every request gets a 401 Basic challenge until
# the visitor enters the correct credentials. Leave EMPTY in production so the
# public site is reachable.
#
# Skipped: /_next/*, favicon, placeholder image, /internal/revalidate webhook,
# and /monitoring Sentry tunnel. See src/proxy.ts.
# -----------------------------------------------------------------------------
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
